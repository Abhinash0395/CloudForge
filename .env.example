# ============================================================
# RISKLENS AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Track 01 — AI, ML & Emerging Technologies
# PS 05 — AI for Prediction & Decision Support
# ============================================================

# Application Environment & Ports
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Default local SQLite database (Zero manual configuration needed for local dev)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase / Neon / Render / Railway):
# DATABASE_URL="postgresql://username:password@localhost:5432/risklens_prod?schema=public"

# AI Reasoning Layer (Google Gemini API)
# Optional: The platform operates in Deterministic Fallback Mode if omitted
GEMINI_API_KEY=""

# Google Maps & Geocoding APIs (Optional)
# If omitted, Open-Meteo & OpenStreetMap Cartography provides full open-source fallback
GOOGLE_MAPS_API_KEY=""
GOOGLE_GEOCODING_API_KEY=""
GOOGLE_AIR_QUALITY_API_KEY=""

# Open Data Endpoints
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1"
COPERNICUS_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1"

# Security & Session Authentication
JWT_SECRET="risklens-ai-enterprise-secret-key-track01-ps05"
